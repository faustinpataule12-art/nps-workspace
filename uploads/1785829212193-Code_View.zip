Fichier : android-overrides/app/build.gradle
Contenu :
apply plugin: 'com.android.application'

android {
    namespace "com.nps.viewer"
    compileSdk 34

    defaultConfig {
        applicationId "com.nps.viewer"
        minSdkVersion 23
        targetSdkVersion 34
        versionCode 1
        versionName "1.0.0"
        multiDexEnabled true
    }

    /*
      Signature release : aucune valeur en dur dans le repo.
      Tout vient de variables d'environnement injectées par le workflow
      GitHub Actions à partir de secrets (voir release-apk.yml + KEYSTORE.md).
    */
    signingConfigs {
        release {
            if (System.getenv("NPS_KEYSTORE_PATH")) {
                storeFile file(System.getenv("NPS_KEYSTORE_PATH"))
                storePassword System.getenv("NPS_KEYSTORE_PASSWORD")
                keyAlias System.getenv("NPS_KEY_ALIAS")
                keyPassword System.getenv("NPS_KEY_PASSWORD")
            }
        }
    }

    buildTypes {
        debug {
            debuggable true
        }
        release {
            minifyEnabled true
            shrinkResources true
            proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'proguard-rules.pro'
            signingConfig signingConfigs.release
        }
    }

    packagingOptions {
        exclude 'META-INF/DEPENDENCIES'
    }
}

repositories {
    google()
    mavenCentral()
}

dependencies {
    implementation fileTree(include: ['*.jar'], dir: 'libs')
    implementation "androidx.appcompat:appcompat:1.7.0"
    implementation "androidx.core:core-splashscreen:1.0.1"
    implementation project(':capacitor-android')
    implementation project(':capacitor-cordova-android-plugins')
}

apply from: 'capacitor.build.gradle'


