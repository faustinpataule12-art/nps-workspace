Fichier : android-overrides/app/src/main/java/com/nps/viewer/MainActivity.java
Contenu :
package com.nps.viewer;

import android.content.Intent;
import android.net.Uri;
import android.os.Bundle;
import android.webkit.MimeTypeMap;
import com.getcapacitor.BridgeActivity;

import java.io.File;
import java.io.FileOutputStream;
import java.io.InputStream;

/*
  Reçoit le fichier ouvert via "Ouvrir avec" (ACTION_VIEW), le copie en flux
  (jamais tout en mémoire, donc pas de plantage même sur plusieurs gigaoctets)
  dans le cache de l'app, puis appelle window.npsOpenNativeFile(url, nom, mime)
  dans index.html via Capacitor.convertFileSrc().
*/
public class MainActivity extends BridgeActivity {

  @Override
  protected void onCreate(Bundle savedInstanceState) {
    super.onCreate(savedInstanceState);
    handleIncomingIntent(getIntent());
  }

  @Override
  protected void onNewIntent(Intent intent) {
    super.onNewIntent(intent);
    setIntent(intent);
    handleIncomingIntent(intent);
  }

  private void handleIncomingIntent(Intent intent) {
    if (intent == null) return;
    String action = intent.getAction();
    Uri uri = intent.getData();
    if (!Intent.ACTION_VIEW.equals(action) || uri == null) return;

    new Thread(() -> {
      try {
        String name = queryDisplayName(uri);
        String mime = getContentResolver().getType(uri);
        if (mime == null) mime = guessMimeFromName(name);

        File outFile = new File(getCacheDir(), "npsviewer_" + System.currentTimeMillis() + "_" + name);
        try (InputStream in = getContentResolver().openInputStream(uri);
             FileOutputStream out = new FileOutputStream(outFile)) {
          byte[] buf = new byte[8192];
          int n;
          while (in != null && (n = in.read(buf)) != -1) out.write(buf, 0, n);
        }

        final String finalName = name;
        final String finalMime = mime;
        final String path = outFile.getAbsolutePath();

        runOnUiThread(() -> {
          String js = "window.npsOpenNativeFile(Capacitor.convertFileSrc('" + path.replace("'", "\\'") + "'), '"
              + finalName.replace("'", "\\'") + "', '" + finalMime + "');";
          getBridge().getWebView().evaluateJavascript(js, null);
        });

      } catch (Exception e) {
        e.printStackTrace();
      }
    }).start();
  }

  private String queryDisplayName(Uri uri) {
    String result = "fichier";
    try (android.database.Cursor cursor = getContentResolver().query(uri, null, null, null, null)) {
      if (cursor != null && cursor.moveToFirst()) {
        int idx = cursor.getColumnIndex(android.provider.OpenableColumns.DISPLAY_NAME);
        if (idx != -1) result = cursor.getString(idx);
      }
    } catch (Exception ignored) {}
    return result;
  }

  private String guessMimeFromName(String name) {
    String ext = MimeTypeMap.getFileExtensionFromUrl(name);
    if (ext == null) return "application/octet-stream";
    String mime = MimeTypeMap.getSingleton().getMimeTypeFromExtension(ext.toLowerCase());
    return mime != null ? mime : "application/octet-stream";
  }
}


